// GuildCloud tailnet policy — Guild-A.
//
// Source of truth. Do not edit this policy in the Tailscale admin console —
// changes made there will be overwritten the next time this file is applied
// and will not be reflected in git history.
//
// Managed via GitOps: .github/workflows/tailscale-acl.yml validates every
// pull request that touches this file and applies it to the live tailnet on
// merge to main.
//
// This version (2026-08-25, replacing the previous policy.hujson) removes
// the two tailnet-wide wildcard grants and reconciles drift between the
// committed file and the live policy. Full reasoning:
// docs/decisions/2026-08-22-tailnet-wildcard-grants-and-drift.md. Verified
// against the live policy directly (`tailscale::manage_policy_file get`)
// immediately before this change to confirm no further drift had occurred
// since that decision was written — same 3 tenant-project tags, same single
// enrolled-member grant.
//
// Two reasons this file changed:
//
// 1. The two wildcard grants allowed every device on the tailnet to reach
//    every other device, including tag:guildcloud-mgmt. That contradicted
//    Master Plan §6 ("Management — never customer reachable") and the
//    console's own Networking page. Their original rationale was explicit
//    and honest: "this tailnet currently has only one real identity —
//    GuildCloud has no customer devices enrolled yet (Phase 3 doesn't
//    exist)." Phase 3 now exists. Real devices enrol as
//    tag:guildcloud-member, so the stated precondition no longer holds.
//
// 2. The previous policy.hujson had DRIFTED from the live tailnet. The live
//    policy carried tags and grants that file never had: tag:guildcloud-member,
//    tag:guildcloud-pool, and three tag:guildcloud-tenant-<slug> tags,
//    added directly via the API by the site worker (applyPendingProjectAcls)
//    and the enroll-device Edge Function. Applying the old file as it stood
//    would have DELETED all of them, instantly orphaning every instance tag
//    and cutting off every enrolled device. This version folds the live
//    dynamic state back in.
//
// NOTE ON COMMENTS: enroll-device and applyPendingProjectAcls both GET the
// policy as JSON, mutate it, and POST it back. That round-trip STRIPS every
// comment in this file. Expect these comments to vanish from the live
// policy the first time anyone enrols a device or creates a project — the
// file stays the readable source of truth, the live copy will not be.

{
	"tagOwners": {
		// Pre-existing, unrelated to GuildCloud. Left as-is.
		"tag:gean-devnet": ["davidpius95@gmail.com"],

		// GuildCloud zone tags.
		"tag:guildcloud-mgmt":   ["davidpius95@gmail.com"],
		"tag:operator":          ["davidpius95@gmail.com"],
		"tag:guildcloud-tenant": ["davidpius95@gmail.com"],

		// Customer-device tags are now membership-specific and are reconciled
		// by the site worker: tag:guildcloud-member-<membership-id8>. Do not
		// add a generic customer-member tag here; it would make it possible to
		// grant every enrolled device project-wide reachability by accident.

		// Added live by the warm-pool path in the site worker.
		"tag:guildcloud-pool": ["davidpius95@gmail.com"],

		// Added live by applyPendingProjectAcls, one per real project.
		// This list will grow without touching this file; that drift is
		// expected and documented, not a mistake.
		"tag:guildcloud-tenant-project-b44c4107": ["davidpius95@gmail.com"],
		"tag:guildcloud-tenant-project-076fcbd6": ["davidpius95@gmail.com"],
		"tag:guildcloud-tenant-project-5e81b859": ["davidpius95@gmail.com"],
	},

	"groups": {
		// These seven identities reached tag:gean-devnet ONLY through the
		// wildcard grants being removed below. Without this explicit group
		// they would silently lose access — the SSH rule alone is not
		// enough, an SSH connection still needs a network grant.
		"group:gean-devnet-users": [
			"manbankat@gmail.com",
			"shaaibusuleiman9@gmail.com",
			"itodosimonitodo1@gmail.com",
			"dimkayilrit@gmail.com",
			"kefasiceking@gmail.com",
			"nodebridgeafric@gmail.com",
			"developerlongs@gmail.com",
		],
	},

	"acls": [],

	"grants": [
		// --- Replaces the two wildcard grants -------------------------------
		// Tailnet admins keep unrestricted reach, so operating the fleet and
		// the owner's personal services (homeassistant, deepseek, guild-gpu,
		// agent-knowledge-bank, netalertx, usher-node, ...) is unaffected.
		// Tagged devices are NOT autogroup:admin, so no customer device and
		// no instance matches this.
		{
			"src": ["autogroup:admin"],
			"dst": ["*"],
			"ip":  ["*"],
		},
		// Every other tailnet user reaches their own devices, and nothing
		// else. This is the line that actually replaces "* -> *".
		{
			"src": ["autogroup:member"],
			"dst": ["autogroup:self"],
			"ip":  ["*"],
		},
		// Preserves the gean-devnet access the wildcards were providing.
		{
			"src": ["group:gean-devnet-users"],
			"dst": ["tag:gean-devnet"],
			"ip":  ["*"],
		},
		{
			"src": ["tag:gean-devnet"],
			"dst": ["tag:gean-devnet"],
			"ip":  ["*"],
		},

		// --- Management zone (§6): never customer reachable -----------------
		{
			"src": ["tag:operator"],
			"dst": ["tag:guildcloud-mgmt"],
			"ip":  ["*"],
		},
		{
			"src": ["tag:guildcloud-mgmt"],
			"dst": ["tag:guildcloud-mgmt"],
			"ip":  ["*"],
		},
		// Management reaches tenant workloads (worker-initiated operations),
		// deliberately one-directional — the reverse is NOT granted below.
		{
			"src": ["tag:guildcloud-mgmt"],
			"dst": ["tag:guildcloud-tenant", "tag:guildcloud-pool"],
			"ip":  ["*"],
		},
		// Missing piece found 2026-08-25: the "ssh" section below already
		// accepts tag:operator -> tag:guildcloud-tenant/-pool (operator
		// support access into customer instances), but that ssh ACL is only
		// ever reached if the underlying network grant lets the packet
		// through first. Without this entry, plain OpenSSH from an operator
		// device timed out on port 22 - Tailscale drops ungranted traffic
		// silently rather than refusing it, which is exactly the symptom
		// reported. Real gap introduced when the wildcard grants were
		// removed (PR #7/#8) - the ssh stanza was written to assume this
		// grant, but it was never added.
		{
			"src": ["tag:operator"],
			"dst": ["tag:guildcloud-tenant", "tag:guildcloud-pool"],
			"ip":  ["*"],
		},

		// --- Tenant zone (§6) ------------------------------------------------
		// CHANGED vs live: dst no longer includes tag:guildcloud-mgmt. A
		// customer workload must not be able to reach Proxmox nodes, PBS, the
		// site workers, or the router. The live grants have that dst today
		// because site-worker/index.js:448 writes it for every new project —
		// that line needs the same edit or this regresses one project at a
		// time. (applyPendingProjectAcls only checks whether a grant with
		// that src exists, so these three tightened entries will NOT be
		// rewritten; only newly created projects would reintroduce it.)
		{
			"src": ["tag:guildcloud-tenant-project-b44c4107"],
			"dst": ["tag:guildcloud-tenant-project-b44c4107"],
			"ip":  ["*"],
		},
		{
			"src": ["tag:guildcloud-tenant-project-076fcbd6"],
			"dst": ["tag:guildcloud-tenant-project-076fcbd6"],
			"ip":  ["*"],
		},
		{
			"src": ["tag:guildcloud-tenant-project-5e81b859"],
			"dst": ["tag:guildcloud-tenant-project-5e81b859"],
			"ip":  ["*"],
		},

		// --- Enrolled customer devices ---------------------------------------
		// No generic member grant exists. The housekeeping worker derives one
		// narrow tag:guildcloud-member-<membership> ->
		// tag:guildcloud-instance-<instance> grant for each Owner/Admin or
		// explicit access_grants row. A customer device cannot reach a project
		// tag, management tag, or any unrelated tailnet device by default.

		// Backup zone (§6): still intentionally absent. guild-pbs currently
		// carries tag:guildcloud-mgmt rather than a dedicated backup tag.
	],

	"ssh": [
		// Each user into their own devices.
		{
			"action": "accept",
			"src":    ["autogroup:member", "autogroup:admin"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot", "root"],
		},
		// CHANGED vs live: autogroup:member removed from management SSH. The
		// live rule lets any tailnet user SSH into tag:guildcloud-mgmt as
		// root — that is the Proxmox nodes, PBS, the site workers, and the
		// router. Operators only now.
		{
			"action": "accept",
			"src":    ["tag:operator", "tag:guildcloud-mgmt", "davidpius95@gmail.com"],
			"dst":    ["tag:guildcloud-mgmt"],
			"users":  ["root", "autogroup:nonroot"],
		},
		// Customer SSH is deliberately not declared as a generic member rule.
		// The site worker creates matching membership-specific, non-root rules
		// only for the instance tags that the member is permitted to reach.
		// Operators retain their support access through the explicit rule above.
		// Pre-existing, unchanged.
		{
			"action": "accept",
			"src":    ["group:gean-devnet-users"],
			"dst":    ["tag:gean-devnet"],
			"users":  ["root", "autogroup:nonroot"],
		},
	],

	"nodeAttrs": [
		{
			"target": ["autogroup:member"],
			"attr":   ["funnel"],
		},
	],
}
