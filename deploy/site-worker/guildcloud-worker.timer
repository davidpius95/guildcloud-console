[Unit]
Description=Run a GuildCloud site-worker cycle every 3 minutes
# index.js's LOOP_BUDGET_MS bounds one run() invocation to 150s; the 3-minute
# cadence below always leaves a gap rather than racing the next cycle's start
# against the previous one still finishing.

[Timer]
OnBootSec=30s
OnUnitActiveSec=3min
Unit=guildcloud-worker.service

[Install]
WantedBy=timers.target
