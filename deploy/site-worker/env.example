# /etc/guildcloud/worker.env on any Guild-* worker LXC. Must be root:root
# 0600 - the worker refuses to start otherwise (see assertSecureWorkerEnvFile
# in index.js). Copy this file per cluster, fill in the real values, and
# never commit a filled-in copy. See deploy/site-worker-guild-a/env.example
# for Guild-A's actual values (safe to check in - no secret values live in
# an env file, only secret NAMES that get resolved from Supabase Vault).

WORKER_CLUSTER_ID=
WORKER_SITE_ID=lag-1
WORKER_ID=

PVE_HOST=
PVE_PORT=8006
PVE_TOKEN_SECRET_NAME=
PVE_POOL_ID=

BACKUP_JOB_ID=
BACKUP_STORAGE=guild-pbs
# BACKUP_NAMESPACE: leave unset for a PBS datastore with no namespace
# (Guild-A); set to the cluster's namespace otherwise (Guild-B: guild-b).
BACKUP_NAMESPACE=

SNIPPETS_DIR=/mnt/guild-snippets
SNIPPETS_STORAGE_ID=guild-snippets

TAILSCALE_TAILNET=
TAILSCALE_TAG_OWNER=
TAILSCALE_POOL_TAG=tag:guildcloud-pool

# Leave the warm pool and tailnet-housekeeping-owner role off by default -
# see config.js. Enable per cluster deliberately, not by copy-paste.
WARM_POOL_ENABLED=false
# WARM_POOL_IMAGE_ID=
# WARM_POOL_PLAN_ID=
# WARM_POOL_TARGET=
# WARM_POOL_NODE=

TAILNET_HOUSEKEEPING_OWNER=false

# legacy until this cluster's phase of the multi-cluster placement rollout
# reaches Phase R3 (or, for a first-onboarded cluster, R6); see
# docs/superpowers/plans/2026-08-18-multi-cluster-placement.md
PLACEMENT_CLAIM_MODE=legacy

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
