# /etc/guildcloud/worker.env on the Guild-A LXC (vmid 500). root:root 0600.
# Copy this file, fill in the real values, and never commit the filled-in copy.

WORKER_CLUSTER_ID=guild-a
WORKER_SITE_ID=lag-1
WORKER_ID=guild-a-lxc-500

PVE_HOST=192.168.8.195
PVE_PORT=8006
PVE_TOKEN_SECRET_NAME=proxmox_guild_a_site_worker_token
PVE_POOL_ID=guildcloud-guild-a

BACKUP_JOB_ID=guild-a-standard-daily
BACKUP_STORAGE=guild-pbs
# BACKUP_NAMESPACE intentionally unset - Guild-A's PBS datastore has no namespace.

SNIPPETS_DIR=/mnt/guild-snippets
SNIPPETS_STORAGE_ID=guild-snippets

TAILSCALE_TAILNET=tail345216.ts.net
TAILSCALE_TAG_OWNER=davidpius95@gmail.com
TAILSCALE_POOL_TAG=tag:guildcloud-pool

WARM_POOL_ENABLED=true
WARM_POOL_IMAGE_ID=ubuntu-2404
WARM_POOL_PLAN_ID=std-2
WARM_POOL_TARGET=1
WARM_POOL_NODE=nodeD

TAILNET_HOUSEKEEPING_OWNER=true

# legacy until Phase R3 of the multi-cluster placement rollout; see
# docs/superpowers/plans/2026-08-18-multi-cluster-placement.md
PLACEMENT_CLAIM_MODE=legacy

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
